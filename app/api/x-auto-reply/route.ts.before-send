import { NextResponse } from "next/server";
import OpenAI from "openai";
import OAuth from "oauth-1.0a";
import crypto from "crypto";

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

const oauth = new OAuth({
  consumer: {
    key: process.env.X_CONSUMER_KEY!,
    secret: process.env.X_CONSUMER_SECRET!,
  },
  signature_method: "HMAC-SHA1",
  hash_function(baseString, key) {
    return crypto
      .createHmac("sha1", key)
      .update(baseString)
      .digest("base64");
  },
});

const token = {
  key: process.env.X_OAUTH1_ACCESS_TOKEN!,
  secret: process.env.X_OAUTH1_ACCESS_TOKEN_SECRET!,
};

const MY_USER_ID = "2084661197438435328";

async function xOAuth1Get(url: string) {
  const auth = oauth.authorize(
    {
      url,
      method: "GET",
    },
    token
  );

  return fetch(url, {
    headers: {
      Authorization: oauth.toHeader(auth).Authorization,
    },
  });
}

async function aiJudgeAndReply(text: string) {
  const ai = await openai.chat.completions.create({
    model: "gpt-4.1-mini",
    messages: [
      {
        role: "system",
        content: `
あなたはAI NEWS ジャパンの「やんすAI」です。

X投稿を見て、「本人が何かを達成したことを報告している投稿」か判定してください。

対象：
- フォロワー数達成
- 登録者数達成
- 売上達成
- スコア達成
- 資格・試験などの達成
- 個人的な目標達成
- その他、本人が明確に成果を達成した報告

対象外：
- 「達成を目指す」「達成したい」など未来の目標
- 達成方法を説明するノウハウ
- 商品・サービスの宣伝
- アフィリエイト
- LINE誘導
- 集客・営業目的の投稿
- 他人の達成を紹介する投稿
- 単なる「達成」という単語を含むだけの投稿

JSONだけ返してください。

{
  "isAchievement": true,
  "reply": "返信文"
}

isAchievementがfalseの場合、replyは空文字にしてください。

返信条件：
- 30文字程度
- 自然なお祝い
- 押し売り・宣伝は禁止
- フォロー要求は禁止
- 絵文字は1個まで
- 最後は自然に「でやんす」で締める
`,
      },
      {
        role: "user",
        content: `投稿：\n${text}`,
      },
    ],
    temperature: 0.5,
    max_tokens: 100,
  });

  const content = ai.choices[0]?.message?.content?.trim() ?? "";

  try {
    return JSON.parse(content) as {
      isAchievement: boolean;
      reply: string;
    };
  } catch {
    return {
      isAchievement: false,
      reply: "",
    };
  }
}

export async function GET() {
  try {
    // =========================================
    // 1. 複数条件で達成報告を検索
    // =========================================

    const queries = [
      '"達成しました"',
      '"達成した"',
      '"達成！"',
      '"達成!"',
      '"人達成"',
      '"フォロワー" "達成"',
      '"登録者" "達成"',
      '"目標達成"',
    ];

    const allTweets: Array<{
      id: string;
      author_id: string;
      text: string;
      created_at?: string;
    }> = [];

    for (const query of queries) {
      const searchUrl =
        "https://api.x.com/2/tweets/search/recent?" +
        new URLSearchParams({
          query: `${query} -is:retweet lang:ja`,
          max_results: "20",
          "tweet.fields": "author_id,created_at,text",
        }).toString();

      const response = await fetch(searchUrl, {
        headers: {
          Authorization: `Bearer ${process.env.X_ACCESS_TOKEN}`,
        },
      });

      const data = await response.json();

      if (!response.ok) {
        return NextResponse.json(
          {
            error: "X検索エラー",
            query,
            detail: data,
          },
          { status: response.status }
        );
      }

      allTweets.push(...(data.data ?? []));
    }

    // 重複除去
    const uniqueTweets = Array.from(
      new Map(allTweets.map((tweet) => [tweet.id, tweet])).values()
    );

    // =========================================
    // 2. フォロワーを全ページ取得
    // =========================================

    const followerIds = new Set<string>();
    let nextToken: string | undefined;

    do {
      const params = new URLSearchParams({
        max_results: "100",
        "user.fields": "id,name,username",
      });

      if (nextToken) {
        params.set("pagination_token", nextToken);
      }

      const followersUrl =
        `https://api.x.com/2/users/${MY_USER_ID}/followers?${params.toString()}`;

      const response = await xOAuth1Get(followersUrl);
      const data = await response.json();

      if (!response.ok) {
        return NextResponse.json(
          {
            error: "フォロワー取得エラー",
            detail: data,
          },
          { status: response.status }
        );
      }

      for (const user of data.data ?? []) {
        followerIds.add(user.id);
      }

      nextToken = data.meta?.next_token;
    } while (nextToken);

    // =========================================
    // 3. フォロワーの投稿だけに絞る
    // =========================================

    const followerTweets = uniqueTweets.filter((tweet) =>
      followerIds.has(tweet.author_id)
    );

    // =========================================
    // 4. AI判定
    // =========================================

    const candidates = [];

    for (const tweet of followerTweets.slice(0, 10)) {
      const result = await aiJudgeAndReply(tweet.text);

      if (!result.isAchievement || !result.reply) {
        continue;
      }

      candidates.push({
        tweetId: tweet.id,
        authorId: tweet.author_id,
        text: tweet.text,
        reply: result.reply,
        isFollower: true,
      });

      if (candidates.length >= 3) {
        break;
      }
    }

    return NextResponse.json({
      mode: "FOLLOWER_ACHIEVEMENT_TEST",
      searched: uniqueTweets.length,
      followerCount: followerIds.size,
      followerTweets: followerTweets.length,
      matched: candidates.length,
      candidates,
    });
  } catch (error) {
    console.error("X自動返信テストエラー:", error);

    return NextResponse.json(
      {
        error: "X自動返信テストに失敗しました",
      },
      { status: 500 }
    );
  }
}
